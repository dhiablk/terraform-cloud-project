# terraform.tfvars.example — copy to terraform.tfvars and adapt.
# NEVER put real secrets in this file: the DB password comes from
# the CI/CD secret store, or from an environment variable (TF_VAR_db_master_password).

project_name        = "cloud5"
environment         = "dev"
owner               = "dhiablk"
aws_region          = "eu-west-1"
vpc_cidr            = "10.20.0.0/16"
instance_type       = "t3.micro"
min_size            = 2
max_size            = 4
db_instance_class   = "db.t3.micro"
